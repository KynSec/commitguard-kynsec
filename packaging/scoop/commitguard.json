{
  "version": "3.4.2",
  "description": "Offline-first local security control plane for secrets, SAST, SCA, and policy",
  "homepage": "https://github.com/KynSec/commitguard-kynsec",
  "license": "Apache-2.0",
  "depends": ["python", "git"],
  "url": "https://github.com/KynSec/commitguard-kynsec/releases/download/v3.4.2/commitguard_kynsec-3.4.2.tar.gz",
  "hash": "40ee44083f2ea3a69df3838de8d097409da95a692c31658be3d216d152af2151",
  "extract_dir": "commitguard_kynsec-3.4.2",
  "installer": {
    "script": [
      "python -m pip install --user --no-warn-script-location .",
      "if (!(Test-Path \"$dir\\commit-guard.cmd\")) { @'",
      "@echo off",
      "python -m install_hook %*",
      "'@ | Out-File -Encoding ascii \"$dir\\commit-guard.cmd\" }"
    ]
  },
  "bin": ["bin\\commit-guard.cmd"],
  "checkver": {
    "github": "https://github.com/KynSec/commitguard-kynsec"
  },
  "autoupdate": {
    "url": "https://github.com/KynSec/commitguard-kynsec/releases/download/v$version/commitguard_kynsec-$version.tar.gz",
    "extract_dir": "commitguard_kynsec-$version"
  }
}
